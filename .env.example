# =============================================================================
# Intelligent PDF Parser — environment configuration
# Copy to `.env` and fill in. Nothing here is required to *start* the service;
# the router degrades to whatever backends/providers are configured.
# =============================================================================

# ----- App -----
APP_ENV=production
LOG_LEVEL=INFO
MAX_UPLOAD_MB=50

# ----- Persistence -----
# SQLite file holding run history, per-run logs, and Q&A chat. Created on first
# use; the directory is made automatically. Excluded from git via /data/.
DB_PATH=./data/app.db
# Default analyst-question count when a run does not specify one.
DEFAULT_NUM_QUESTIONS=12

# ----- LLM provider selection -----
# Provider used for reasoning (handwriting interpretation + Q&A generation).
# One of: openai | anthropic | azure | ollama
LLM_PROVIDER=anthropic

# Vision provider (page-image understanding). Defaults to LLM_PROVIDER if unset.
# One of: openai | anthropic | azure | ollama
VISION_PROVIDER=anthropic

# ----- OpenAI -----
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
OPENAI_VISION_MODEL=gpt-5.5

# ----- Anthropic (Claude) -----
# Vision model reads handwriting/scans (use the strongest); the text model
# generates Q&A and can be a cheaper tier.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_VISION_MODEL=claude-opus-4-8

# ----- Azure OpenAI -----
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2025-04-01-preview
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_VISION_DEPLOYMENT=

# ----- Ollama (self-hosted, no key) -----
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.3
OLLAMA_VISION_MODEL=llama3.2-vision

# ----- Parser backends -----
# Preferred parsing backend: auto | docling | llamaparse | vision_llm
# `auto` runs the router (cheap backend first, vision-LLM fallback for
# handwritten / low-confidence pages).
PARSER_BACKEND=auto

# LlamaParse (API only — cannot self-host)
LLAMA_CLOUD_API_KEY=

# Confidence threshold (0-1). Pages scoring below this are escalated to the
# vision-LLM backend during `auto` parsing.
PARSER_CONFIDENCE_THRESHOLD=0.62
HANDWRITING_SCAN_CHAR_THRESHOLD=20
HANDWRITING_IMAGE_AREA_THRESHOLD=0.15
HANDWRITING_TEXT_AREA_THRESHOLD=0.35

# Force every page through the vision-LLM backend (highest accuracy, highest
# cost). Useful for documents known to be handwriting-heavy.
FORCE_VISION_LLM=false

# Image detail sent to vision models for handwriting/low-quality scans.
# auto | original  (per OpenAI GPT-5.4 vision guidance, June 2026)
VISION_IMAGE_DETAIL=original
VISION_RENDER_DPI=200
VISION_MAX_CONCURRENCY=4
